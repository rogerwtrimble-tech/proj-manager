# Copy to .env and fill in. With none of these set, the app runs in DEMO mode
# with seeded sample projects so you can evaluate it immediately.

# Your SharePoint site (the migration hub / target site)
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/YourSite

# Azure AD app registration (app-only / client credentials) with Microsoft
# Graph application permissions: Sites.ReadWrite.All + Files.ReadWrite.All.
# Grant admin consent in the portal. (The Read-only pair passes the
# connection test only — the pipeline uploads Results/ back to SharePoint;
# don't substitute Sites.Selected without its per-site grant.
# See AZURE-SETUP.md.)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional: user whose OneDrive is enumerated for OneDrive projects
ONEDRIVE_USER_UPN=

# Token required for Admin tools in the UI (X-Admin-Token header)
ADMIN_TOKEN=change-me-to-something-long-and-random

# Shared secret for the dashboard "Migration prep" tile (visitors who
# know it can run stage -> unzip -> pre-check -> report). Defaults to
# ADMIN_TOKEN when unset.
RUN_PASSWORD=
